# Enforce LF for shell scripts so they execute correctly on Ubuntu/Linux
*.sh text eol=lf

# Python files - normalize to LF
*.py text eol=lf

# JSON / config files - normalize to LF
*.json text eol=lf

# Windows-native text files - CRLF is fine
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files - no line-ending conversion
*.pkl binary
*.png binary
*.jpg binary
*.csv binary
